<div class="personal-site site-home">
  <section class="space-hero" aria-labelledby="home-title">
    <div class="space-hero-copy">
      <p class="space-eyebrow">KIOOO808 <span aria-hidden="true">/</span> 个人空间</p>
      <h1 id="home-title">无限可能！</h1>
      <p class="space-intro"><%= page.personal.description %></p>
    </div>
    <nav class="space-entries" id="home-navigation" aria-label="首页导航">
      <% for (const [key, title, icon] of [['','首页','icon-home-fill'], ['projects','项目','icon-link-fill'], ['knowledge','知识库','icon-category-fill'], ['blog','博客','icon-articles'], ['diary','日记','icon-date-fill'], ['about','关于','icon-user-fill']]) { %>
        <a class="space-nav-tile<%= key === '' ? ' is-current' : '' %>" data-section="<%= key || 'home' %>" aria-controls="space-content" href="<%= url_for('/' + (key ? key + '/' : '')) %>"<%- key === '' ? ' aria-current="page"' : '' %>><i class="iconfont <%= icon %>" aria-hidden="true"></i><span><%= title %></span></a>
      <% } %>
      <% if (theme.search.enable) { %><button class="space-nav-tile" type="button" data-section="search" aria-controls="space-content"><i class="iconfont icon-search" aria-hidden="true"></i><span>搜索</span></button><% } %>
      <% if (theme.dark_mode.enable) { %><button class="space-nav-tile" type="button" id="color-toggle-btn" aria-label="切换亮色或暗黑模式"><i class="iconfont icon-dark" id="color-toggle-icon" aria-hidden="true"></i><span class="space-lights-off">暗黑</span><span class="space-lights-on">亮色</span></button><% } %>
    </nav>
  </section>
  <p class="space-navigation-status sr-only" role="status" aria-live="polite"></p>
  <div id="space-content" class="space-view" data-search-index="<%= url_for(theme.search.path) %>"><div class="space-view-inner" data-section="home">
  <div class="space-home-feed">
    <section class="space-section space-featured" aria-labelledby="projects-heading">
      <div class="space-section-heading"><h2 id="projects-heading">项目</h2><a href="<%= url_for('/projects/') %>">全部 ↗</a></div>
      <%- partial('personal-project-cards', { projects: page.personal.projects }) %>
    </section>
    <section class="space-section space-recent" aria-labelledby="recent-heading">
      <div class="space-section-heading"><h2 id="recent-heading">最近更新</h2><a href="<%= url_for('/archives/') %>">归档 ↗</a></div>
      <%- partial('personal-post-list', { posts: page.recent }) %>
    </section>
  </div>
  <section class="space-section space-knowledge" aria-labelledby="knowledge-heading">
    <div class="space-section-heading"><h2 id="knowledge-heading">知识库</h2><a href="<%= url_for('/knowledge/') %>">全部主题 ↗</a></div>
    <div class="space-topic-grid"><% page.personal.topics.forEach((topic, index) => { %><a class="space-topic" href="<%= url_for('/knowledge/#topic-' + index) %>"><span class="space-topic-number">0<%= index + 1 %></span><div><h3><%= topic.name %></h3><p><%= topic.description %></p></div><span aria-hidden="true">↗</span></a><% }) %></div>
  </section>
  </div></div>
  <template id="space-search-template"><section class="space-inline-search" aria-labelledby="space-search-title"><div class="space-panel-heading"><h2 id="space-search-title">搜索</h2></div><label class="sr-only" for="space-search-input">搜索文章、笔记</label><input type="search" id="space-search-input" placeholder="搜索文章、笔记…" autocomplete="off"><p class="space-search-status" role="status" aria-live="polite">输入关键词，查找站内内容。</p><div class="space-search-results"></div></section></template>
  <div class="space-closing"><span>kiooo808</span><nav aria-label="更多内容"><a href="<%= url_for('/archives/') %>">归档</a><a href="<%= url_for('/tags/') %>">标签</a><a href="<%= url_for('/about/') %>">关于</a></nav></div>
</div>
